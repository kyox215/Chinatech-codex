SUPABASE_URL=https://xluzcoduqsdvjoouqhkc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://xluzcoduqsdvjoouqhkc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vtNntEx_C4DOerJA6SGcLg__I2ugApQ
NEXT_PUBLIC_SITE_URL=https://www.chinatech.in
REPAIRDESK_EMAIL_INVITES_ENABLED=true

# Client-side preload is enabled unless explicitly set to 0.
NEXT_PUBLIC_REPAIRDESK_PRELOAD_ENABLED=1

# Keep both realtime switches off until private-channel authorization is applied and verified.
NEXT_PUBLIC_REPAIRDESK_REALTIME_ENABLED=0

# Keep offline order replay disabled until its database RPC migrations and server-only HMAC secret
# have passed the linked dry-run and production release gate. Never expose the HMAC secret as NEXT_PUBLIC_*.
NEXT_PUBLIC_REPAIRDESK_OFFLINE_SYNC_ENABLED=0
REPAIRDESK_OFFLINE_SYNC_HMAC_SECRET=
REPAIRDESK_REALTIME_BROADCAST_ENABLED=0

# Kiosk stays fail-closed in production and every Supabase-backed non-E2E runtime until WP05-B is approved.
# Both switches are required end to end; never enable a master-only data-collection state.
REPAIRDESK_KIOSK_PRODUCTION_ENABLED=0
REPAIRDESK_KIOSK_REVIEW_WRITES_ENABLED=0

# Order-data export/preview and apply are independent, fail-closed high-risk controls.
# Keep apply disabled until the workflow/default-warranty parity and maximum-batch DB gates are approved.
ORDER_DATA_EXPORT_ENABLED=0
ORDER_DATA_APPLY_ENABLED=0

# Internal repair-line costs stay hidden and all cost endpoints stay closed unless exactly "1".
REPAIRDESK_ORDER_COSTS_ENABLED=0

# Phase 2 internal-cost capabilities are independent, fail-closed children of the Phase 1 flag.
REPAIRDESK_PROFIT_REPORTS_ENABLED=0
REPAIRDESK_PARTS_PROCUREMENT_ENABLED=0
REPAIRDESK_COST_EXPORT_ENABLED=0
REPAIRDESK_COST_BACKFILL_ENABLED=0
REPAIRDESK_COST_MULTI_CURRENCY_ENABLED=0

# RepairDesk AI assistant is fail-closed. Keep every switch at 0 and the provider on fake until
# the budget, external-data/privacy, dependency, rollout and production release gates are approved.
# Vision also requires approved server-side image decoding before any real external image request.
# Roll back immediately by setting AI_ASSISTANT_ENABLED=0.
AI_ASSISTANT_ENABLED=0
AI_ORDER_READ_TOOLS_ENABLED=0
AI_VISION_INTAKE_ENABLED=0
AI_DRAFT_APPLY_ENABLED=0
AI_PUBLIC_CUSTOMER_ASSISTANT_ENABLED=0
AI_ASSISTANT_PROVIDER=fake
AI_ASSISTANT_STORE_ALLOWLIST=
AI_ASSISTANT_REQUESTS_PER_STORE_DAY=0
AI_ASSISTANT_EXTERNAL_DATA_APPROVED=0
AI_ASSISTANT_BUDGET_APPROVED=0
OPENAI_AI_ASSISTANT_MODEL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
