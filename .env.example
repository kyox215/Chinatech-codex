SUPABASE_URL=https://xluzcoduqsdvjoouqhkc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://xluzcoduqsdvjoouqhkc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vtNntEx_C4DOerJA6SGcLg__I2ugApQ
NEXT_PUBLIC_SITE_URL=https://www.chinatech.in
REPAIRDESK_EMAIL_INVITES_ENABLED=true

# Every repair order uses one stable customer-status QR. The active key must be present in the
# versioned keyring and contain at least 32 random bytes encoded as base64url. Keep older versions
# during key rotation so already printed QR codes continue to resolve. Never expose these values.
CUSTOMER_STATUS_QR_HMAC_ACTIVE_VERSION=1
CUSTOMER_STATUS_QR_HMAC_KEYS={"1":"replace-with-base64url-32-byte-secret"}
CUSTOMER_STATUS_PUBLIC_ORIGIN=https://www.chinatech.in
CUSTOMER_STATUS_RATE_LIMIT_SECRET=replace-with-an-independent-random-secret

# Client-side preload is enabled unless explicitly set to 0.
NEXT_PUBLIC_REPAIRDESK_PRELOAD_ENABLED=1

# Keep both realtime switches off until private-channel authorization is applied and verified.
NEXT_PUBLIC_REPAIRDESK_REALTIME_ENABLED=0
# Independent 30-second metadata revision check; it never polls full order data.
NEXT_PUBLIC_REPAIRDESK_REVISION_CHECK_ENABLED=0

# Keep offline order replay disabled until its database RPC migrations and server-only HMAC secret
# have passed the linked dry-run and production release gate. Never expose the HMAC secret as NEXT_PUBLIC_*.
NEXT_PUBLIC_REPAIRDESK_OFFLINE_SYNC_ENABLED=0

# Default-off rollout gate for the store-scoped four-step quick-order guided mode.
NEXT_PUBLIC_REPAIRDESK_NEW_ORDER_SIMPLE_MODE_ENABLED=0
REPAIRDESK_OFFLINE_SYNC_HMAC_SECRET=
REPAIRDESK_REALTIME_BROADCAST_ENABLED=0

# Kiosk stays fail-closed in production and every Supabase-backed non-E2E runtime until WP05-B is approved.
# Both switches are required end to end; never enable a master-only data-collection state.
REPAIRDESK_KIOSK_PRODUCTION_ENABLED=0
REPAIRDESK_KIOSK_REVIEW_WRITES_ENABLED=0

# Order-data export/preview and apply are independent, fail-closed high-risk controls.
# Keep apply disabled until the workflow/default-warranty parity and maximum-batch DB gates are approved.
ORDER_DATA_EXPORT_ENABLED=0
ORDER_DATA_APPLY_ENABLED=0

# Internal repair-line costs stay hidden and all cost endpoints stay closed unless exactly "1".
REPAIRDESK_ORDER_COSTS_ENABLED=0

# Phase 2 internal-cost capabilities are independent, fail-closed children of the Phase 1 flag.
REPAIRDESK_PROFIT_REPORTS_ENABLED=0
REPAIRDESK_PARTS_PROCUREMENT_ENABLED=0
REPAIRDESK_COST_EXPORT_ENABLED=0
REPAIRDESK_COST_BACKFILL_ENABLED=0
REPAIRDESK_COST_MULTI_CURRENCY_ENABLED=0

# Store memos are fail-closed. Enable the server switch and add exact store UUIDs only after the
# additive migration, security checks and rollback evidence pass. Wildcards are intentionally ignored.
REPAIRDESK_MEMOS_ENABLED=0
REPAIRDESK_MEMOS_STORE_ALLOWLIST=

# Inventory Product V2 is additive and fail-closed. Keep every switch at 0 and the
# rollout lists empty until the linked migrations, restore proof and store rollout are approved.
INVENTORY_V2_SCHEMA_READY=0
INVENTORY_V2_SHADOW_READ=0
INVENTORY_V2_COMMANDS=0
INVENTORY_V2_UI=0
INVENTORY_PRODUCT_DEVICE_DATA_V2=0
INVENTORY_V2_ALL_STORES_ENABLED=0
INVENTORY_V2_STORE_ALLOWLIST=
INVENTORY_V2_STORE_DENYLIST=
INVENTORY_LEGACY_MUTATIONS_ENABLED=1

# Inventory Product Lifecycle is additive and fail-closed. The schema migration
# and service-role RPC enablement are separate gates; keep flags off and lists
# empty until production recovery, RLS/grant, smoke and rollback evidence pass.
INVENTORY_LIFECYCLE_SCHEMA_READY=0
INVENTORY_LIFECYCLE_COMMANDS=0
INVENTORY_LIFECYCLE_UI=0
INVENTORY_LIFECYCLE_ALL_STORES_ENABLED=0
INVENTORY_LIFECYCLE_STORE_ALLOWLIST=
INVENTORY_LIFECYCLE_STORE_DENYLIST=

# Product inspection is independent from lifecycle UI/commands and remains off
# until the additive orchestration migration, RLS/grant rehearsal and rollout
# approval are complete.
INVENTORY_PRODUCT_INSPECTION_SCHEMA_READY=0
INVENTORY_PRODUCT_INSPECTION_ENABLED=0
INVENTORY_PRODUCT_INSPECTION_ALL_STORES=0
INVENTORY_PRODUCT_INSPECTION_ALLOWLIST=
INVENTORY_PRODUCT_INSPECTION_DENYLIST=

# RepairDesk AI assistant is fail-closed. Keep every switch at 0 and the provider on fake until
# the budget, external-data/privacy, dependency, rollout and production release gates are approved.
# Vision also requires approved server-side image decoding before any real external image request.
# Roll back immediately by setting AI_ASSISTANT_ENABLED=0.
AI_ASSISTANT_ENABLED=0
AI_ORDER_READ_TOOLS_ENABLED=0
AI_ORDER_INLINE_ACTIONS_ENABLED=0
AI_VISION_INTAKE_ENABLED=0
AI_DRAFT_APPLY_ENABLED=0
AI_PUBLIC_CUSTOMER_ASSISTANT_ENABLED=0
AI_ASSISTANT_PROVIDER=fake
# All-store order assistance is local/read-only unless a store is also named in the
# exact provider allowlist. The legacy allowlist remains the pilot boundary for Vision,
# inline writes and backwards-compatible provider access.
AI_ORDER_ASSISTANT_ALL_STORES_ENABLED=0
AI_ORDER_ASSISTANT_STORE_DENYLIST=
AI_ORDER_PROVIDER_STORE_ALLOWLIST=
AI_ASSISTANT_STORE_ALLOWLIST=
AI_ASSISTANT_REQUESTS_PER_STORE_DAY=0
AI_ASSISTANT_REQUESTS_PER_ACTOR_MINUTE=30
AI_ASSISTANT_EXTERNAL_DATA_APPROVED=0
AI_ASSISTANT_ORDER_EXTERNAL_DATA_APPROVED=0
AI_ASSISTANT_VISION_EXTERNAL_DATA_APPROVED=0
AI_ASSISTANT_BUDGET_APPROVED=0
# Paid provider settings remain blank/zero until the Owner approves the exact
# policy and the durable Supabase migration has been applied and verified.
AI_ASSISTANT_DURABLE_QUOTA_BACKEND=
AI_ASSISTANT_POLICY_VERSION=
AI_ASSISTANT_PRICING_VERSION=
AI_ASSISTANT_MONTHLY_BUDGET_MICRO_USD=0
AI_ASSISTANT_ORDER_TEXT_PER_STORE_DAY=0
AI_ASSISTANT_INVENTORY_VISION_PER_STORE_DAY=0
AI_ASSISTANT_PROVIDER_REQUESTS_GLOBAL_DAY=0
AI_ASSISTANT_QUOTA_TIMEZONE=
AI_ASSISTANT_SAFETY_IDENTIFIER_SECRET=
AI_ASSISTANT_REQUEST_FINGERPRINT_SECRET=
AI_ASSISTANT_MAINTENANCE_ENABLED=0
AI_ASSISTANT_USAGE_RETENTION_DAYS=0
CRON_SECRET=
OPENAI_AI_ASSISTANT_ORDER_MODEL=
OPENAI_AI_ASSISTANT_VISION_MODEL=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
