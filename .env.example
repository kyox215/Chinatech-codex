# Local preview only. Never use the local auth/database adapter on Vercel.
LOCAL_PREVIEW=1
# Set supabase only after configuring this project's isolated business schemas. Preview never runs in production.
BACKEND_MODE=preview
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# A dedicated role created by this project's migration; never postgres/service_role.
APP_DATABASE_URL=postgresql://chinatech_runtime.YOUR_PROJECT_REF:REPLACE_PASSWORD@YOUR_POOLER:6543/postgres
APP_ORIGIN=http://localhost:3117
# Request-scoped page reads are enabled by default. Set 0 only to roll back to
# the compatible v1 read protocol; authorization and write checks remain active.
BACKEND_V2_READS=1
# Independent server-only 32-byte signing key, lowercase hexadecimal. Never NEXT_PUBLIC.
OFFICE_COMMAND_SIGNING_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

# Separate server-only desktop signing secret (32 random bytes as hex).
OFFICE_DESKTOP_SIGNING_KEY=

# Office 1.4 v3: server-only ECDSA P256 key. Never embed it in EXEs or NEXT_PUBLIC.
# Configure PKCS8 PEM with real newlines in the deployment secret, not a public file.
OFFICE_DESKTOP_V3_KID=office-v3-20261013
OFFICE_DESKTOP_V3_PRIVATE_KEY=
# Optional JSON object of previous kid => SPKI PEM for already-started task recovery.
OFFICE_DESKTOP_V3_PUBLIC_KEYS={}
# Separate random 32-byte lowercase hex key; hashes trusted Vercel source IPs for rate limits.
OFFICE_DESKTOP_V3_RATE_SECRET=

# Fixed Office v3 retention maintenance. Unset/false keeps POST execution disabled.
# GET previews are admin-only; no automatic cron is configured.
OFFICE_DESKTOP_V3_CLEANUP_ENABLED=false

# Opt in only after the customer read-model migration and verified store backfill.
# 0 keeps the existing complete customer-directory read contract for rollback.
BACKEND_CUSTOMER_LIST_READS=0

# Opt in only after procurement projection migration, bounded backfill and oracle.
# 0 retains complete compatibility reads; canonical writes always stay active.
BACKEND_PROCUREMENT_LIST_READS=0
BACKEND_REPAIR_LIST_READS=0

# Retail/history opt-in after versioned vocabulary and verified bounded backfill.
BACKEND_RETAIL_LIST_READS=0
# Enable only after the retail form projection is backfilled and verified.
BACKEND_RETAIL_FORM_READS=0

# Enable only after customer-record canonical verification; requires ready customer/repair models.
BACKEND_CUSTOMER_DETAIL_READS=0
