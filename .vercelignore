# M7 inventory canary packaging: deny everything, then allow only Next runtime inputs.
*
!src
!src/**
!public
!public/**
!scripts
!scripts/copy-local-ocr-assets.mjs
!package.json
!package-lock.json
!next.config.ts
!postcss.config.mjs
!tsconfig.json
!next-env.d.ts
!vercel.json
!.nvmrc

# Tests and Storybook are never part of the production candidate.
tests/
**/*.test.*
**/*.spec.*
**/*.stories.*
src/features/inventory/stories/
coverage/
playwright-report/
test-results/

# Non-runtime repository surfaces and local/build state.
docs/
tools/
outputs/
artifacts/
storybook-static/
.ai-company/
.agents/
.codex/
.github/
.storybook/
AI智能部门管理/
/supabase/
screenshots/
exports/
node_modules/
.next/
.git/
.vercel/
.env
.env.*
